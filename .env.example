# 本地开发样例配置。Secret 不写入仓库；生产通过 Docker secrets 注入。
APP_ENV=development
DATABASE_URL=postgresql+psycopg://memory:memory@127.0.0.1:55432/memory
MEMORY_STORAGE_ROOT=.local/memory
KNOWLEDGE_GRAPH_ROOT=knowledge_graph
BACKUP_ROOT=.local/backups

# Dev Auth（仅 development；生产必须为 false）
DEV_AUTH_ENABLED=true
DEV_AUTH_ALLOW_SCOPE_OVERRIDE=false
# 前端开发（npm run dev / preview）：该值由 frontend/vite.config.ts 读取并注入
# X-Dev-User-Id（运行目录为 frontend/，需放在 frontend/.env 或以环境变量传入）。
# 配置后访客无需登录也能加载数据（后端以该开发身份处理请求）；前端不再强制登录。
MEMORY_DEV_USER_ID=00000000-0000-4000-8000-000000000001
MEMORY_DEV_API_TARGET=http://localhost:8000

# OpenAI（本地 CI 使用 Fake Client，不需要真实 key）
OPENAI_API_KEY=
OPENAI_MEMORY_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_MEMORY_TIMEOUT_SECONDS=45

# 生产认证（方案 §6.2 / 评审 P1-4 / 复审 P1-1、P2-6）。
# 生产（APP_ENV=production）启动校验：缺以下任何一项 Settings 构造直接失败——
#   AUTH_PRIVATE_KEY_FILE：必须指向存在、可读、RSA 2048 位、权限精确 0600 的私钥文件
#   AUTH_PUBLIC_KEY_FILE / AUTH_PUBLIC_KEY：必须提供其一，且与私钥匹配
#   AUTH_DATABASE_URL：必须显式设置（无默认回退）
# 第一版 token 不带 kid，生产环境不允许仅配置 AUTH_JWKS_URL（验签无法选中密钥）。
# 本地开发：bash scripts/generate_auth_keys.sh 生成 .local/keys/ 密钥对。
AUTH_ISSUER=gewu-auth
AUTH_AUDIENCE=memory-api
AUTH_DATABASE_URL=postgresql+psycopg://auth:auth@127.0.0.1:55432/auth
AUTH_PRIVATE_KEY_FILE=.local/keys/auth_private.pem
AUTH_PUBLIC_KEY_FILE=.local/keys/auth_public.pem
AUTH_PUBLIC_KEY=
# 保留给将来外部 IdP（第一版生产不可 JWKS-only）
AUTH_JWKS_URL=
# 反向代理部署必填：可信代理 CIDR 白名单（auth 端点据此解析 X-Forwarded-For）；
# 默认空 = 仅信任直连地址（方案 §10.1 / 附录 A.2 #9）。列表以 JSON 形式解析。
AUTH_TRUSTED_PROXY_CIDRS=[]
SERVICE_TOKEN_AUDIENCE=memory-api

# HMAC 密钥（本地占位；生产必须注入真实随机密钥）
LOG_HMAC_KEY=dev-log-hmac-key
PRIVACY_HMAC_KEY=dev-privacy-hmac-key
PRIVACY_HMAC_KEY_VERSION=v1
CURSOR_HMAC_KEY=dev-cursor-hmac-key

# 数据库超时（§13.18 固定值）
DATABASE_STATEMENT_TIMEOUT_MS=150000
DATABASE_LOCK_TIMEOUT_MS=10000

# 备份（age 加密，§14.7）
BACKUP_ENCRYPTION_METHOD=age-x25519-v1
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY_FILE=

# 前端（Vite proxy，§20.4）
VITE_MEMORY_API_BASE_URL=/memory-api

# 教材 Embedding Artifact（阶段二；不连接数据库）
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=
# DashScope 兼容变量；EMBEDDING_API_KEY 为空时使用
DASHSCOPE_API_KEY=
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_BATCH_SIZE=10
RAG_EMBEDDING_CONCURRENCY=4
RAG_EMBEDDING_TIMEOUT_SECONDS=60
RAG_EMBEDDING_MAX_ATTEMPTS=6
RAG_EMBEDDING_INITIAL_BACKOFF_SECONDS=1
RAG_EMBEDDING_MAX_BACKOFF_SECONDS=30
RAG_EMBEDDING_JITTER_SECONDS=0.5
RAG_EMBEDDING_REQUESTS_PER_SECOND=0
# 可选：每百万计费 token 单价；未配置时 usage.json 的费用为 null
RAG_EMBEDDING_PRICE_PER_MILLION_TOKENS=

# RAG 专用 PostgreSQL（阶段三；与 Memory DATABASE_URL、数据库和 volume 完全隔离）
RAG_DATABASE_URL=postgresql+psycopg://rag:rag@127.0.0.1:55433/rag
RAG_DATABASE_SCHEMA=rag
RAG_STATEMENT_TIMEOUT_MS=150000
RAG_LOCK_TIMEOUT_MS=10000
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSIONS=1024
RAG_LEXICAL_PIPELINE_VERSION=zh-bigram-formula/v1
RAG_IMPORT_BATCH_SIZE=100
RAG_HNSW_EF_SEARCH=100
RAG_RRF_K=60

# ===================== Conversation Agentic RAG（方案 §20 / v1.4） =====================
# 数据与运行时
CONVERSATION_DATABASE_URL=postgresql+psycopg://conversation:conversation@127.0.0.1:55432/conversation
CONVERSATION_GRAPH_CHECKPOINT_SCHEMA=conversation_checkpoints
CONVERSATION_MAX_ACTIVE_TURNS_PER_THREAD=1
CONVERSATION_WORKER_POLL_SECONDS=1
CONVERSATION_TURN_LEASE_SECONDS=60
CONVERSATION_TURN_MAX_ATTEMPTS=3
CONVERSATION_JOB_MAX_ATTEMPTS=10
CONVERSATION_RETENTION_SWEEP_INTERVAL_HOURS=24
CONVERSATION_MAX_USER_MESSAGE_CHARS=10000
CONVERSATION_LIST_DEFAULT_LIMIT=50
CONVERSATION_LIST_MAX_LIMIT=100
CONVERSATION_TURN_RATE_LIMIT_PER_MINUTE=10
CONVERSATION_INTERNAL_TESTER_USER_IDS=
CONVERSATION_CONTEXT_MAX_MESSAGES=20
CONVERSATION_CONTEXT_TOKEN_BUDGET=6000
CONVERSATION_MEMORY_TOKEN_BUDGET=3000
CONVERSATION_ANSWER_TOKEN_BUDGET=2000
CONVERSATION_SUMMARY_TRIGGER_TOKENS=8000
CONVERSATION_TURN_DEADLINE_SECONDS=120

# RAG 与 Query Embedding（复用现有 EMBEDDING_*，不新增重复凭证）
CONVERSATION_RETRIEVAL_MAX_SUBQUERIES=4
CONVERSATION_RETRIEVAL_MAX_TOTAL_SUBQUERIES=6
CONVERSATION_RETRIEVAL_MAX_ITERATIONS=1
CONVERSATION_RETRIEVAL_CONCURRENCY=4
CONVERSATION_RETRIEVAL_WORKER_TIMEOUT_SECONDS=5
CONVERSATION_RETRIEVAL_TOTAL_TIMEOUT_SECONDS=10
CONVERSATION_RETRIEVAL_RESULT_LIMIT=20
CONVERSATION_RETRIEVAL_ADJACENT_CHUNKS_PER_SIDE=1
CONVERSATION_RETRIEVAL_MERGED_HIT_MAX_TOKENS=1500
CONVERSATION_CITATION_SNIPPET_MAX_CHARS=300
CONVERSATION_EVIDENCE_TOKEN_BUDGET=4000

# Memory、Reader 与 Outbox
MEMORY_API_BASE_URL=http://127.0.0.1:8000
MEMORY_AGENT_TOKEN=
MEMORY_CONTEXT_TIMEOUT_SECONDS=5
CONVERSATION_READER_BASE_URL=
CONVERSATION_READER_SERVICE_TOKEN=
CONVERSATION_SOURCE_DELETE_SERVICE_TOKEN=
CONVERSATION_OUTBOX_POLL_SECONDS=1
CONVERSATION_OUTBOX_LEASE_SECONDS=60
CONVERSATION_OUTBOX_MAX_ATTEMPTS=10

# SSE
CONVERSATION_SSE_HEARTBEAT_SECONDS=15
CONVERSATION_SSE_EVENT_RETENTION_DAYS=30
CONVERSATION_CHECKPOINT_RETENTION_DAYS=30
CONVERSATION_SSE_DELTA_BATCH_MS=100
CONVERSATION_SSE_DELTA_BATCH_CHARS=64

# 模型角色（不写死模型名，按角色配置；附录 A.10 能力矩阵）
OPENAI_REWRITE_MODEL=
OPENAI_EVIDENCE_MODEL=
OPENAI_ANSWER_MODEL=
OPENAI_CONVERSATION_SUMMARY_MODEL=

# Feature Flags（附录 A.10 降级路径）
CONVERSATION_AGENTIC_RAG_ENABLED=true
CONVERSATION_MULTI_QUERY_ENABLED=true
CONVERSATION_EVIDENCE_LOOP_ENABLED=true
CONVERSATION_MEMORY_READ_ENABLED=true
CONVERSATION_MEMORY_SUBMIT_ENABLED=true
CONVERSATION_STREAMING_ENABLED=true

# ===================== Community 社区（方案 community-implementation-plan.md v1.6） =====================
# 数据与运行时：独立 community 数据库（§4.2 / D44 账号约定 community/community）
COMMUNITY_DATABASE_URL=postgresql+psycopg://community:community@127.0.0.1:55432/community
# 内部 Reader 与三个服务 token（§10.3 / D36 principal 命名）；空 = 对应链路 disabled
COMMUNITY_READER_BASE_URL=
COMMUNITY_READER_SERVICE_TOKEN=
COMMUNITY_SOURCE_DELETE_SERVICE_TOKEN=
COMMUNITY_ACCOUNT_PURGE_SERVICE_TOKEN=

# Feature Flags（§10.1 / D7：初始默认关闭，按 deletion→evidence 顺序灰度）
COMMUNITY_PUBLISHER_ENABLED=false
COMMUNITY_MEMORY_SUBMIT_ENABLED=false
COMMUNITY_SOURCE_DELETION_ENABLED=false

# Outbox Publisher 与维护任务（D38 默认值与 conversation 对齐）
COMMUNITY_OUTBOX_POLL_SECONDS=1
COMMUNITY_OUTBOX_LEASE_SECONDS=60
COMMUNITY_OUTBOX_MAX_ATTEMPTS=10
COMMUNITY_OUTBOX_BATCH_SIZE=50
COMMUNITY_MAINTENANCE_INTERVAL_SECONDS=3600

# 保留与清理（§12.4）
COMMUNITY_IDEMPOTENCY_RETENTION_DAYS=7
COMMUNITY_OUTBOX_DELIVERED_RETENTION_DAYS=30
COMMUNITY_OUTBOX_DEAD_LETTER_RETENTION_DAYS=90
COMMUNITY_NOTIFICATION_RETENTION_DAYS=90
COMMUNITY_CLEANUP_BATCH_SIZE=500

# 内容限制（§6.2）
COMMUNITY_POST_BODY_MAX_LENGTH=19500
COMMUNITY_REPLY_MAX_LENGTH=19500

# 限流（§9.3 墙钟固定窗口；D19 接受边界突发）
COMMUNITY_RATE_LIMIT_POST_PER_HOUR=10
COMMUNITY_RATE_LIMIT_REPLY_PER_MINUTE=5
COMMUNITY_RATE_LIMIT_REPLY_PER_HOUR=60
COMMUNITY_RATE_LIMIT_LIKE_PER_MINUTE=60
COMMUNITY_RATE_LIMIT_READ_PER_MINUTE=120

# 可信代理 CIDR（D18：默认空 = 仅信任直连对端；生产必须填写真实网关网段）
COMMUNITY_TRUSTED_PROXY_CIDRS=[]

# ------------------------------------------------------------------
# Study 学习编排（docs/study-plan-push-implementation-plan.md v1.2，§19）
# Feature Flags 全部默认关闭："实现不等于批准启用"（§19）
# ------------------------------------------------------------------
STUDY_DOMAIN_ENABLED=false
# STUDY_DATABASE_URL 留空 = 不挂载 Study 路由（§21，与 Community D25 同模式）；
# 启用 Study 域前先建库（docker/postgres/initdb 的 study 账号）并执行迁移：
#   STUDY_DATABASE_URL=...study  uv run alembic -c study_alembic.ini upgrade head
# STUDY_DATABASE_URL=postgresql+psycopg://study:study@127.0.0.1:55432/study
STUDY_DATABASE_URL=
STUDY_GRAPH_CHECKPOINT_SCHEMA=study_checkpoints
STUDY_MEMORY_READ_ENABLED=false
STUDY_DAILY_FEED_ENABLED=false
STUDY_AUTO_REPLAN_ENABLED=false
STUDY_MEMORY_WRITEBACK_ENABLED=false
STUDY_NOTIFICATION_ENABLED=false

# Worker / Scheduler（D9/D17）
STUDY_WORKER_CONCURRENCY=4
STUDY_WORKER_POLL_SECONDS=1
STUDY_OPERATION_LEASE_SECONDS=120
STUDY_OPERATION_SOFT_TIMEOUT_SECONDS=150
STUDY_OPERATION_HARD_TIMEOUT_SECONDS=180
STUDY_SCHEDULER_TIMEZONE=Asia/Shanghai
STUDY_DAILY_FEED_SCAN_INTERVAL_SECONDS=300
STUDY_DAILY_FEED_SCAN_BATCH_SIZE=100

# 幂等与模型响应缓存（D15/D16）
STUDY_IDEMPOTENCY_RETENTION_DAYS=7
STUDY_MODEL_RESPONSE_CACHE_RETENTION_DAYS=30

# Intake 与 Session（D10/§7.1/§12.5）
STUDY_INTAKE_REQUEST_TIMEOUT_SECONDS=8
STUDY_INTAKE_MAX_MESSAGES=8
STUDY_INTAKE_MESSAGE_MAX_CHARS=2000
STUDY_INTAKE_TTL_HOURS=24
STUDY_SESSION_HEARTBEAT_SECONDS=60
STUDY_SESSION_HEARTBEAT_MIN_INTERVAL_SECONDS=30
STUDY_SESSION_IDLE_TIMEOUT_SECONDS=120

# 内部 purge（D19：fail-closed，未配置 token 不挂载路由）
STUDY_ACCOUNT_PURGE_SERVICE_TOKEN=

# 模型角色（§19；Phase 1 manual 路径不依赖模型，Phase 2 启用前必须配置）
OPENAI_STUDY_INTAKE_MODEL=
OPENAI_STUDY_PLAN_MODEL=
OPENAI_STUDY_FEED_MODEL=
