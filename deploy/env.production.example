# 生产环境变量模板（community-rebuild-plan.md 5.1/5.6）。
# 用法：cp deploy/env.production.example .env.production && chmod 600 .env.production
# 然后逐项填值。.env.production 被 .gitignore（.env.* 规则）排除，绝不入库。
# 标记 <执行时抄录> 的项确定后要同步写入 docs/ops/startup.md 5.6 部署记录表。

# ============ 镜像与构建版本（禁一切浮动 tag，执行时抄录） ============
# 后端/备份自研镜像 tag = git short SHA（服务器上 git rev-parse --short HEAD）
GIT_SHA=<执行时抄录：如 c9be274>
# postgres 17 系补丁版（与开发 compose 大版本 17 一致；docker hub 抄录，如 postgres:17.6）
POSTGRES_IMAGE=<执行时抄录：如 postgres:17.6>
# node 24 系补丁版（不降 22），前端一次性 build job 用，如 node:24.7.0-slim
NODE_IMAGE=<执行时抄录：如 node:24.x-slim>
# backup 镜像基础（补丁版），如 alpine:3.22
ALPINE_IMAGE=<执行时抄录：如 alpine:3.x>

# ============ 核心开关（生产强校验，缺即启动失败） ============
APP_ENV=production
COMMUNITY_V2_ENABLED=true
COMMUNITY_STORAGE_BACKEND=kodo
# 允许的前端来源（JSON 数组）
MEMORY_ALLOWED_ORIGINS=["https://xueshen.xin","https://www.xueshen.xin"]

# ============ 七牛云 Kodo（五项缺一不可；Region ∈ z0/z1/z2/na0/as0/cn-east-2） ============
KODO_ACCESS_KEY=<七牛控制台 AccessKey>
KODO_SECRET_KEY=<七牛控制台 SecretKey>
KODO_BUCKET=<生产 Bucket 名，与测试分桶>
KODO_REGION=<如 z0>
# 裸域名，禁 scheme/端口/路径/末尾斜杠（如 cdn.xueshen.xin）
KODO_CDN_DOMAIN=<CDN 加速域名>

# ============ 社区管理员（生产至少 1 个 UUID，逗号分隔） ============
# 部署冒烟后注册账号，从 auth 库 SELECT user_id FROM users 得到
COMMUNITY_ADMIN_USER_IDS=<部署后补：你的 user_id UUID>

# ============ postgres 超级用户（仅 initdb/备份/运维用，不进应用配置） ============
POSTGRES_PASSWORD=<强密码：仅字母数字，initdb SQL 拼接不做引号转义>

# ============ 五库双角色密码（initdb 首次建库建角色用，仅字母数字） ============
# <db>_owner = 迁移用（属主 DDL）；<db>_app = 运行时用（最小权限）
PG_MEMORY_OWNER_PASSWORD=<生成>
PG_MEMORY_APP_PASSWORD=<生成>
PG_AUTH_OWNER_PASSWORD=<生成>
PG_AUTH_APP_PASSWORD=<生成>
PG_CONVERSATION_OWNER_PASSWORD=<生成>
PG_CONVERSATION_APP_PASSWORD=<生成>
PG_COMMUNITY_OWNER_PASSWORD=<生成>
PG_COMMUNITY_APP_PASSWORD=<生成>
PG_RAG_OWNER_PASSWORD=<生成>
PG_RAG_APP_PASSWORD=<生成>

# ============ 运行时连接串（应用进程，最小权限 app 角色） ============
DATABASE_URL=postgresql+psycopg://memory_app:${PG_MEMORY_APP_PASSWORD}@postgres:5432/memory
AUTH_DATABASE_URL=postgresql+psycopg://auth_app:${PG_AUTH_APP_PASSWORD}@postgres:5432/auth
CONVERSATION_DATABASE_URL=postgresql+psycopg://conversation_app:${PG_CONVERSATION_APP_PASSWORD}@postgres:5432/conversation
COMMUNITY_DATABASE_URL=postgresql+psycopg://community_app:${PG_COMMUNITY_APP_PASSWORD}@postgres:5432/community
RAG_DATABASE_URL=postgresql+psycopg://rag_app:${PG_RAG_APP_PASSWORD}@postgres:5432/rag

# ============ 迁移连接串（migrate job，属主 owner 角色） ============
MEMORY_MIGRATE_DATABASE_URL=postgresql+psycopg://memory_owner:${PG_MEMORY_OWNER_PASSWORD}@postgres:5432/memory
AUTH_MIGRATE_DATABASE_URL=postgresql+psycopg://auth_owner:${PG_AUTH_OWNER_PASSWORD}@postgres:5432/auth
CONVERSATION_MIGRATE_DATABASE_URL=postgresql+psycopg://conversation_owner:${PG_CONVERSATION_OWNER_PASSWORD}@postgres:5432/conversation
COMMUNITY_MIGRATE_DATABASE_URL=postgresql+psycopg://community_owner:${PG_COMMUNITY_OWNER_PASSWORD}@postgres:5432/community
RAG_MIGRATE_DATABASE_URL=postgresql+psycopg://rag_owner:${PG_RAG_OWNER_PASSWORD}@postgres:5432/rag

# ============ 认证签发 ============
# 密钥文件经 compose 挂载到 /secrets（所有后端服务统一挂载，Settings 强校验作用于全部进程，
# 缺此两项时 migrate/worker 等进程同样启动失败；P5 实测踩坑后冻结为 env_file 统一注入）
AUTH_PRIVATE_KEY_FILE=/secrets/auth_private.pem
AUTH_PUBLIC_KEY_FILE=/secrets/auth_public.pem
AUTH_ISSUER=gewu-auth
AUTH_AUDIENCE=memory-api
# 生产强校验：显式关闭开发认证（settings.py 默认 DEV_AUTH_ENABLED=true，生产必须为 false）
DEV_AUTH_ENABLED=false
DEV_AUTH_ALLOW_SCOPE_OVERRIDE=false
# 宿主机 nginx 反代：信任 loopback（auth 端点据此解析 X-Forwarded-For）
AUTH_TRUSTED_PROXY_CIDRS=["127.0.0.1/32","::1/128"]
COMMUNITY_TRUSTED_PROXY_CIDRS=["127.0.0.1/32","::1/128"]

# ============ 服务间 token（各自生成强随机串） ============
COMMUNITY_READER_SERVICE_TOKEN=<生成：openssl rand -hex 32>
COMMUNITY_SOURCE_DELETE_SERVICE_TOKEN=<生成>
COMMUNITY_ACCOUNT_PURGE_SERVICE_TOKEN=<生成>
MEMORY_AGENT_TOKEN=<生成>

# ============ 社区灰度链路（冻结：默认关闭，启用必须等批准） ============
COMMUNITY_PUBLISHER_ENABLED=false
COMMUNITY_MEMORY_SUBMIT_ENABLED=false
COMMUNITY_SOURCE_DELETION_ENABLED=false

# ============ LLM / Embedding（沿用现有第三方服务） ============
OPENAI_API_KEY=<同本地 .env 的 DEEPSEEK_API_KEY 或正式 key>
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MEMORY_MODEL=deepseek-v4-flash
OPENAI_REASONING_EFFORT=none
OPENAI_REWRITE_MODEL=
OPENAI_EVIDENCE_MODEL=
OPENAI_ANSWER_MODEL=
OPENAI_CONVERSATION_SUMMARY_MODEL=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=<同本地 DASHSCOPE_API_KEY>
EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSIONS=1024
RERANK_MODEL=qwen3-rerank
RERANK_BASE_URL=<同本地 .env>
MinerU_API=<同本地 .env>
